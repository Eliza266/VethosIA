# â”€â”€ VetIA API - variables de entorno â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Copia este archivo a .env para correr local. NADA de secrets reales en el repo.

# Puerto (Cloud Run lo inyecta solo; con emuladores locales 8081 evita choque con Firestore 8080).
PORT=8081
API_PREFIX=v1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Proyecto Firebase / bucket de Storage.
# Local+emulador: el ID es label; con *_EMULATOR_HOST no se escribe en la nube.
# Prod: ver docs/VETHOSIA_PROD.md (proyecto nuevo; vetia-dd652 obsoleto).
FIREBASE_PROJECT_ID=vethosia-production
GCLOUD_PROJECT=vethosia-production
STORAGE_BUCKET=vethosia-production.firebasestorage.app

# â”€â”€ Emuladores (solo dev/test) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Descomenta para local. firebase-admin habla con emuladores en vez de la nube.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

# â”€â”€ IA: seleccion de proveedores (adaptadores intercambiables) â”€â”€â”€â”€â”€â”€
# Modo mock local (sin claves reales). Solo dev/test; falla en produccion.
IA_MOCK=true
# STT (speech-to-text): openai (gpt-4o-transcribe) | gemini | mock
STT_PROVIDER=mock
# LLM (estructuracion SOAP): anthropic (claude) | openai | gemini | mock
LLM_PROVIDER=mock

# â”€â”€ Anthropic / Claude (LLM primario para SOAP) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# OJO: claves SOLO server-side. Nunca en el frontend (VITE_*).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_COMPLEX=claude-opus-4-8

# â”€â”€ OpenAI (STT primario / fallback LLM) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe

# â”€â”€ Gemini (fallback STT y LLM) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# â”€â”€ Pagos (Wompi, Colombia) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1

# â”€â”€ Sesion â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SESSION_INACTIVITY_HOURS=8

# â”€â”€ Email â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
EMAIL_FROM=vetiasoporte@gmail.com
# Opcion A: SendGrid (si esta, se usa y se ignora SMTP).
SENDGRID_API_KEY=
# Opcion B: SMTP (SES/Mailgun/etc). Sin EMAIL_HOST se asume Gmail (legacy).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=vetiasoporte@gmail.com
EMAIL_PASS=
# Rate limit basico de envios por destinatario.
EMAIL_RATE_LIMIT_MAX=5
EMAIL_RATE_LIMIT_WINDOW_MS=60000
# Modo mock local (sin SendGrid/SMTP). Solo dev/test; falla en produccion.
# EMAIL_MOCK=true

# Invitaciones (HMAC de tokens; obligatorio en produccion, min 32 chars, recomendado 48+)
INVITE_SECRET=
INVITE_TTL_HORAS=48

# â”€â”€ Cola IA asincrona â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# inmemory (default, dev) | cloudtasks (prod).
QUEUE_DRIVER=inmemory
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=vetia-ia
# URL publica del worker (este mismo servicio): https://<run-url>/v1/ia/procesar
IA_WORKER_URL=
CLOUD_TASKS_INVOKER_SA=
# secreto compartido para el worker cuando no usamos OIDC (ej. emulador).
IA_WORKER_SECRET=
