{
  "name": "vetia-api",
  "version": "0.1.0",
  "description": "API REST (NestJS) de VetIA - capa sobre Firebase. Strangler-fig sobre la app actual.",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:rules": "jest --config jest.config.js --selectProjects rules --runInBand",
    "test:integration": "jest --config jest.config.js --selectProjects integration --runInBand",
    "migrate": "ts-node scripts/migrate.ts",
    "seed:emulator": "ts-node scripts/seed-emulator.ts",
    "seed:e2e-local": "ts-node scripts/seed-e2e-local.ts",
    "seed:test-roles": "ts-node scripts/seed-test-roles.ts",
    "migrate:nicovet-demo": "ts-node scripts/migrate-nicovet-a-clinica-demo.ts",
    "seed:data-prueba-demo": "ts-node scripts/seed-data-prueba-clinica-demo.ts",
    "e2e:runtime-smoke": "ts-node scripts/e2e-runtime-smoke.ts",
    "smoke": "ts-node scripts/smoke.ts",
    "set-superadmin": "ts-node scripts/set-superadmin.ts",
    "list-superadmins": "ts-node scripts/list-superadmins.ts"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.2.0",
    "@google-cloud/tasks": "^5.5.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@sendgrid/mail": "^8.1.3",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^12.5.0",
    "iterare": "^1.2.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.13.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
