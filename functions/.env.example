# Config de email para las Cloud Functions.
# En produccion EMAIL_PASS y SENDGRID_API_KEY deben ir como secrets:
#   firebase functions:secrets:set EMAIL_PASS
#   firebase functions:secrets:set SENDGRID_API_KEY
# Para el emulador local, copia este archivo a .env (firebase-functions lo carga solo).

# Remitente que aparece en el "from".
EMAIL_FROM=vetiasoporte@gmail.com

# --- Opcion A: SendGrid (recomendado en prod) ---
# Si esta seteado, se usa SendGrid y se ignora el SMTP de abajo.
SENDGRID_API_KEY=

# --- Opcion B: SMTP generico (SES, Mailgun, etc.) ---
# Si no defines EMAIL_HOST se asume Gmail (modo legacy) usando EMAIL_USER/EMAIL_PASS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=vetiasoporte@gmail.com
EMAIL_PASS=
