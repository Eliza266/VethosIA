# Variables para smoke visual autenticado (Playwright).
# Copia a .env.e2e.local y completa valores localmente. NO commitear .env.e2e.local.

# URL objetivo (producción demo o local)
E2E_BASE_URL=https://vethosia-production.web.app

# Veterinario
E2E_DEMO_VETERINARIO_EMAIL=
E2E_DEMO_VETERINARIO_PASSWORD=

# Admin Veterinaria
E2E_DEMO_ADMIN_VET_EMAIL=
E2E_DEMO_ADMIN_VET_PASSWORD=

# Admin Entidad
E2E_DEMO_ADMIN_ENTIDAD_EMAIL=
E2E_DEMO_ADMIN_ENTIDAD_PASSWORD=

# Superadmin
E2E_DEMO_SUPERADMIN_EMAIL=
E2E_DEMO_SUPERADMIN_PASSWORD=

# Opcional local: mantener email demo desactivado
# VITE_EMAIL_REAL_ENABLED=false

# Ejecutar smoke visual (desde raiz del repo):
#   .\scripts\run-visual-auth.ps1 -BaseUrl "http://127.0.0.1:5173"   # pre-deploy (npm run dev activo)
#   .\scripts\run-visual-auth.ps1 -BaseUrl "https://vethosia-production.web.app"
