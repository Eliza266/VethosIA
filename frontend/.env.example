# ── VetIA Frontend - variables de entorno (Vite) ────────────────────
# Copia a .env.local para desarrollo. Solo variables con prefijo VITE_ llegan al navegador.

# Firebase (config publica del cliente; NO son secretos de servidor).
# Local emulador: usar perfil recomendado abajo con valores fake.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vethosia-production.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vethosia-production
VITE_FIREBASE_STORAGE_BUCKET=vethosia-production.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Desarrollo local sin secrets reales: conecta Auth/Firestore/Storage a los emuladores.
# Solo se usa en dev (Vite). Puertos: Auth 9099, Firestore 8080, Storage 9199.
VITE_USE_FIREBASE_EMULATORS=false

# ── Perfil local recomendado (copiar a .env.local, NO commitear) ─────
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_API_BASE_URL=http://127.0.0.1:8081
# VITE_USE_API_IA=true
# VITE_USE_API_HC=true
# VITE_USE_API_DOCS=true    # PDF server-side via POST /v1/consultas/:id/pdf
# VITE_USE_API_CRUD=true    # pacientes/consultas/citas/vacunas via /v1 (multi-tenant orgId)
# VITE_FIREBASE_API_KEY=fake-api-key
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ── API nueva (NestJS, contrato /v1) ────────────────────────────────
# Base URL de la API que monta el backend. El front pega contra <VITE_API_BASE_URL>/v1/...
# En local con emuladores, Firestore usa 8080; levanta la API en 8081.
VITE_API_BASE_URL=http://localhost:8081

# ── Feature flags (Strangler Fig) ───────────────────────────────────
# Apagados = la app usa el camino viejo (Cloud Functions + Gemini en el cliente).
# Encendidos = usa los endpoints de la API nueva. Migrar de a uno sin romper nada.
# OJO: estos son los nombres que el codigo realmente lee (frontend/src/lib/featureFlags.ts).
VITE_USE_API_HC=false          # POST /v1/consultas/:id/hc en vez de la Cloud Function
VITE_USE_API_IA=false          # /v1/ia/transcribir y /v1/ia/soap en vez de Gemini en el navegador
VITE_USE_API_DOCS=false        # PDF (/v1/consultas/:id/pdf) Y email (/v1/consultas/:id/email) via API
VITE_USE_API_CRUD=false        # CRUD pacientes/consultas/citas/vacunas via /v1 (orgId); legacy si false

# Envío real de correo al propietario (desactivado por defecto en demo comercial).
VITE_EMAIL_REAL_ENABLED=false
# Prefijo de pais por defecto cuando el propietario no trae codigoPais. Default historico: 57 (Colombia).
VITE_WHATSAPP_COUNTRY_CODE=57

# IMPORTANTE: la API key de Gemini YA NO va aca. Se movio al servidor (api/ y functions/).
# Dejar VITE_GEMINI_API_KEY vacia/borrada: exponerla en el cliente fue el problema que cerramos.
# VITE_GEMINI_API_KEY=

# ── Produccion Vethosia (Firebase Web App — config publica, build Hosting) ─
# Copiar a .env.production.local o al pipeline CI; NO commitear overrides privados.
# authDomain custom (vethosia.com) se configura en Firebase Console tras verificar dominio.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=vethosia-production.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=vethosia-production
# VITE_FIREBASE_STORAGE_BUCKET=vethosia-production.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=G-620ZZP7F69
# VITE_USE_FIREBASE_EMULATORS=false
# VITE_API_BASE_URL=https://vetia-api-cwepwj6irq-uc.a.run.app
# VITE_USE_API_HC=true
# VITE_USE_API_IA=true
# VITE_USE_API_DOCS=true
# VITE_USE_API_CRUD=true
